{
    "name": "auth_services",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "@types/express": "^5.0.6",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.9",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@types/winston": "^2.4.4",
        "@typescript-eslint/parser": "^8.71.0",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "winston": "^3.19.0"
    },
    "lint-staged": {
        "*.ts": [
            "bun run format:fix",
            "bun run lint:fix"
        ]
    }
