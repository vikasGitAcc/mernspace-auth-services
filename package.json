{
    "name": "auth_services",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_ENV=dev nodemon --legacy-watch --watch src --ext ts,json --exec \"bun src/server.ts\"",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --verbose",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchAll --verbose"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "latest",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/supertest": "^7.2.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.9",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.14",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@typescript-eslint/parser": "^8.71.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "http-errors": "^2.0.1",
        "nodemon": "^1.14.10",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "ts-node": "^10.9.2",
        "typeorm": "^0.3.31",
        "winston": "^3.19.0"
    },
    "lint-staged": {
        "*.ts": [
            "bun run format:fix",
            "bun run lint:fix"
        ]
    }
}
